# このファイルを .env にコピーして値を設定してください（.env は git にコミットされません）
# cp .env.example .env

# --- Strapi（ブログ機能） ---
# ローカル開発時は http://localhost:1337、公開時は本番 Strapi の URL
VITE_STRAPI_URL=http://localhost:1337

# --- GitHub API（Projects ページ） ---
# 自分の GitHub ユーザー名。公開リポジトリを自動取得して表示します
VITE_GITHUB_USERNAME=SezaimaruHaruchika

# --- EmailJS（お問い合わせフォーム） ---
# EmailJS の管理画面 > Email Services / Email Templates / Account(API Keys) から取得
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- プロフィール / SNS（任意） ---
# 未設定の項目はサイト上に表示されません（GitHub は VITE_GITHUB_USERNAME から自動生成）
VITE_X_URL=
VITE_CONTACT_EMAIL=
